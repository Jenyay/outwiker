custom_styles_inline = {"code": "span.code {\n\tdisplay: inline-block;\n\tbackground: #FBFCD2;\n\tfont-family: monospace;\n\tborder: solid 1px #CCC;\n\tpadding: 0.2em;\n}\n", "notice": "span.notice {\n\tdisplay: inline-block;\n\tcolor: #333;\n\tbackground-color: #e3f7fc;\n\tborder-radius: 1px;\n\tpadding: 0px 2px 0px 2px;\n\tmargin: 2px;\n\tborder:1px solid #8ed9f6;\n}\n", "success": "span.success {\n\tdisplay: inline-block;\n\tcolor: #333;\n\tbackground-color: #e9ffd9;\n\tborder-radius: 1px;\n\tpadding: 0px 2px 0px 2px;\n\tmargin: 2px;\n\tborder:1px solid #a6ca8a;\n}\n", "warn": "span.warn {\n\tdisplay: inline-block;\n\tcolor: #333;\n\tbackground-color: #fff8c4;\n\tborder-radius: 1px;\n\tpadding: 0px 2px 0px 2px;\n\tmargin: 2px;\n\tborder:1px solid #f2c779;\n}\n", "error": "span.error {\n\tdisplay: inline-block;\n\tcolor: #333;\n\tbackground-color: #ffecec;\n\tborder-radius: 1px;\n\tpadding: 0px 2px 0px 2px;\n\tmargin: 2px;\n\tborder:1px solid #f5aca6;\n}\n", "info": "span.info {\n    display: inline-block;\n    color: #333;\n    background-color: #f0f0ff;\n    border-radius: 1px;\n    padding: 0px 2px;\n    margin: 2px;\n    border: 1px solid #b0b0e0;\n}\n", "neutral": "span.neutral {\n    display: inline-block;\n    color: #333;\n    background-color: #f5f5f5;\n    border-radius: 1px;\n    padding: 0px 2px;\n    margin: 2px;\n    border: 1px solid #cccccc;\n}\n", "highlight-blue": "span.highlight-blue {\n    display: inline;\n    background-color: #b3e5fc;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n", "highlight-green": "span.highlight-green {\n    display: inline;\n    background-color: #ccff90;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n", "highlight-orange": "span.highlight-orange {\n    display: inline;\n    background-color: #ffd180;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n", "highlight-pink": "span.highlight-pink {\n    display: inline;\n    background-color: #ffc1e3;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n", "highlight-purple": "span.highlight-purple {\n    display: inline;\n    background-color: #e1bee7;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n", "highlight-yellow": "span.highlight-yellow {\n    display: inline;\n    background-color: #ffff66;\n    color: inherit;\n    padding: 0px 2px;\n    border-radius: 1px;\n}\n"}
custom_styles_block = {"border": "div.border {\n\tpadding: 1em;\n\tmargin: 1em;\n\tborder: 1px solid #000;\n}\n", "code": "div.code {\n\tbackground: #FBFCD2;\n\tfont-family: monospace;\n\tborder: solid 1px #CCC;\n\tpadding: 1em;\n}\n", "frame": "div.frame {\n\tbackground-color: #ddd;\n\tpadding: 1em;\n\tmargin: 1em;\n\tborder: 1px solid #000;\n}\n", "info": "div.info {\n\tcolor: #333;\n\tbackground-color: #f0f0ff;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #b0b0e0;\n}\n", "neutral": "div.neutral {\n\tcolor: #333;\n\tbackground-color: #f5f5f5;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #cccccc;\n}\n", "notice": "div.notice {\n\tcolor: #333;\n\tbackground-color: #e3f7fc;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #8ed9f6;\n}\n", "success": "div.success {\n\tcolor: #333;\n\tbackground-color: #e9ffd9;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #a6ca8a;\n}\n", "warn": "div.warn {\n\tcolor: #333;\n\tbackground-color: #fff8c4;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #f2c779;\n}\n", "error": "div.error {\n\tcolor: #333;\n\tbackground-color: #ffecec;\n\tborder-radius: 10px;\n\tpadding: 10px 10px 10px 10px;\n\tmargin: 10px;\n\tborder:1px solid #f5aca6;\n}\n", "quote-marker": "div.quote-marker {\n    background-color: #ffffcc;\n    padding: 10px 15px;\n    margin: 10px 0;\n    border-radius: 4px;\n    color: #333;\n}\n", "quote-blue": "div.quote-blue {\n    background-color: #e3f2fd;\n    border-left: 5px solid #2196f3;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n    color: #0d47a1;\n}\n", "quote-green": "div.quote-green {\n    background-color: #e8f5e9;\n    border-left: 5px solid #4caf50;\n    color: #1b5e20;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n}\n", "quote-orange": "div.quote-orange {\n    background-color: #fff3e0;\n    border-left: 5px solid #ff9800;\n    color: #4e2600;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n}\n", "quote-pink": "div.quote-pink {\n    background-color: #fce4ec;\n    border-left: 5px solid #ec407a;\n    color: #880e4f;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n}\n", "quote-purple": "div.quote-purple {\n    background-color: #f3e5f5;\n    border-left: 5px solid #ab47bc;\n    color: #4a148c;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n}\n", "quote-yellow": "div.quote-yellow {\n    background-color: #fffde7;\n    border-left: 5px solid #fbc02d;\n    color: #795c00;\n    padding: 12px 18px;\n    margin: 12px 0;\n    border-radius: 6px;\n}\n"}

