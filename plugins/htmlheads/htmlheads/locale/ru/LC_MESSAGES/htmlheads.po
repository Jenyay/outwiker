#: actions.py:34
msgid "Title (:title ...:)"
msgstr "Заголовок (:title ...:)"

#: actions.py:39
msgid ""
"HtmlHeads plugin. Insert (:title... :) command to add <title> tag in the "
"page head."
msgstr ""
"Плагин HtmlHeads. Вставить команду (:title ...:) для добавления тега <title> "
"в заголовок страницы."

#: actions.py:55
msgid "Description (:description ...:)"
msgstr "Описание (:description ...:)"

#: actions.py:60
msgid ""
"HtmlHeads plugin. Insert (:description... :) command to add description in "
"the page head."
msgstr ""
"Плагин HtmlHeads. Вставить команду (:description ...:) для добавления "
"описания в заголовок страницы."

#: actions.py:76
msgid "Keywords (:keywords ...:)"
msgstr "Ключевые слова (:keywords ...:)"

#: actions.py:81
msgid ""
"HtmlHeads plugin. Insert (:keywords... :) command to add keywords in the "
"page head."
msgstr ""
"Плагин HtmlHeads. Вставить команду (:keywords ...:) для ключевых слов в "
"заголовок страницы."

#: actions.py:97
msgid "Custom head (:htmlhead:)"
msgstr "Произвольный заголовок (:htmlhead:)"

#: actions.py:102
msgid ""
"HtmlHeads plugin. Insert (:htmlhead:) command to add custom tags in the page "
"head."
msgstr ""
"Плагин HtmlHeads. Вставить команду (:htmlhead ...:) для добавления "
"пользовательских тегов в заголовок страницы."

#: actions.py:118
msgid "CSS Style (:style:)"
msgstr "Стиль CSS (:style:)"

#: actions.py:123
msgid ""
"HtmlHeads plugin. Insert (:style:) command to add custom CSS style to page."
msgstr ""
"Плагин HtmlHeads. Вставить команду (:style:) для добавления "
"пользовательского стиля CSS в заголовок страницы."

#: controller.py:85
msgid "HTML Headers"
msgstr "Заголовки HTML"

#: plugin.py:32
msgid ""
"Plugin adds wiki commands (:title:), (:description:), (:keywords:) and "
"(:htmlhead:)"
msgstr ""
"Плагин добавляет вики-команды (:title:), (:description:), (:keywords:) и "
"(:htmlhead:)"

#: plugin.py:36
msgid ""
"<b>Usage:</b>\n"
"(:title Page title:)\n"
"\n"
"(:description Page description:)\n"
"\n"
"(:keywords keyword_1, keyword_2, other keyword:)\n"
"\n"
"(:htmlhead:)\n"
"&lt;meta http-equiv='Content-Type' content='text/html; charset=utf-8' /&gt;\n"
"\n"
"&lt;meta name='robots' content='index,follow' /&gt;\n"
"(:htmlheadend:)\n"
msgstr ""
"<b>Использование:</b>\n"
"(:title Заголовок страницы:)\n"
"\n"
"(:description Описание страницы:)\n"
"\n"
"(:keywords ключевое слово 1, ключевое слово 2, ещё одно ключевое слово:)\n"
"\n"
"(:htmlhead:)\n"
"&lt;meta http-equiv='Content-Type' content='text/html; charset=utf-8' /&gt;\n"
"\n"
"&lt;meta name='robots' content='index,follow' /&gt;\n"
"(:htmlheadend:)\n"

