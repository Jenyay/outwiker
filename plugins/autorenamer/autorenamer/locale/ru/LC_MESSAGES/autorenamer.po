#: preferencesPanel.py:25
msgid "Automatically rename all pages according to their first line"
msgstr "Автоматически переименовывать все страницы по их первой строке"

#: preferencesPanel.py:36
msgid ""
"Automatically set first line of the page be the name of this page on page "
"create"
msgstr ""
"Автоматически устанавливать первую строку по имени страницы при создании"

